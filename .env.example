# ─────────────────────────────────────────────────────────────
#  ЭТАП 1 — минимум, чтобы сайт работал (можно оставить пустым)
# ─────────────────────────────────────────────────────────────
# Пароль от админки (страница /admin). Придумай длинный.
ADMIN_PASSWORD=change-me-please

# Публичные контакты, показываются на сайте
NEXT_PUBLIC_PHONE=+380000000000
NEXT_PUBLIC_EMAIL=hello@example.com
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/
NEXT_PUBLIC_TELEGRAM=https://t.me/

# Реквизиты для перевода — их увидит клиент после заказа
NEXT_PUBLIC_PAYMENT_DETAILS=ФОП Прізвище Ім'я / IBAN UA00 0000 0000 0000 0000 0000 000

# ─────────────────────────────────────────────────────────────
#  ЭТАП 2 — Telegram-уведомления о заказах
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
#  ЭТАП 3 — письма (тебе о заказе + клиенту подтверждение)
#  Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#  SMTP_PASS = «пароль приложения», НЕ обычный пароль от почты
# ─────────────────────────────────────────────────────────────
# Brevo через HTTP API — надійніше за SMTP на хостингу:
# ключ не прив'язаний до IP, тому Brevo не блокує доступ.
# Brevo → SMTP & API → API keys → Generate a new API key
BREVO_API_KEY=

# Запасний канал: SMTP. Використовується, лише якщо BREVO_API_KEY порожній.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Останній спокій <no-reply@example.com>"
OWNER_EMAIL=

# ─────────────────────────────────────────────────────────────
#  ЭТАП 4 — база данных Supabase (товары и заказы онлайн)
#  Без неё локально всё хранится в файлах data/*.json
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=coffins
